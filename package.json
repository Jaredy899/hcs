    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "~8.5.19",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "terser": "^5.49.0",
    "typescript": "~5.9.3",
